{
  "name": "goatcolor",
  "description": "The only color picker palette generator you need.",
  "version": "3.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "changelog": "cog changelog",
    "check": "bun run lint && bun run typecheck",
    "clean": "rm -rf node_modules .vitest bun.lock",
    "dev": "vite",
    "fix": "biome check --write src/",
    "format": "biome format --write src/",
    "health": "bun run check && bun run test && bun run build",
    "lint": "biome check src/",
    "postinstall": "lefthook install",
    "preview": "vite preview",
    "release": "cog bump --auto",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "update": "bun update --latest",
    "version": "cog bump --version"
  },
  "dependencies": {
    "@colordx/core": "^5.7.0",
    "@lucide/svelte": "^1.38.0",
    "color-name-list": "^14.48.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
